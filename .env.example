# Required
SDR_TAP_ID=your-tap-id
SDR_API_TOKEN=your-api-token
SDR_CENTER_MHZ=98.0

# SDR driver: "rtltcp" (default) or "soapy" (build with --features soapy + libsoapysdr installed)
SDR_DRIVER=rtltcp

# Gain in dB (applies to all drivers, default 15.0)
SDR_GAIN_DB=15.0


# Tap Hub
TAPHUB_ENDPOINT=api.zako.ac
# TAPHUB_SERVER_NAME=

# Health check (optional, expose a port for liveness probes)
# TAP_HEALTHCHECK_PORT=8080

# rtl_tcp driver (SDR_DRIVER=rtltcp)
# Set RTLTCP_HOST to the rtl_tcp service name when using docker-compose
RTLTCP_HOST=rtltcp
RTLTCP_PORT=1234

# SoapySDR driver (SDR_DRIVER=soapy, requires: cargo build --features soapy)
# Device args examples:
#   driver=rtlsdr
#   driver=hackrf
#   driver=uhd,serial=xxx
#   driver=airspy
# SOAPY_ARGS=driver=rtlsdr
